#!/bin/bash

# irie list - 全worktree一覧表示（git状態含む）
# Usage: irie list [options]

set -e

IRIE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${IRIE_DIR}/lib/git-helpers.sh"

# カラー出力用
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

show_help() {
    cat << 'EOF'
irie list - worktree一覧表示

使い方:
  irie list [options]

オプション:
  -s, --simple    シンプル表示（名前のみ、git状態なし）
  -v, --verbose   詳細表示（変更ファイル一覧）
  -p, --path      パスのみ表示（スクリプト連携用）
  -n, --name      名前のみ表示（スクリプト連携用）
  -h, --help      このヘルプを表示

出力形式:
  デフォルト: 名前とgit状態を表示
  * name     clean                     # 変更なし
    name     dirty (3 files)           # 変更あり
    name     ahead 2                   # リモートより進んでいる

例:
  irie list
  irie list --simple
  irie list --verbose
  irie list --name
EOF
}

# 引数解析
OUTPUT_MODE="default"
VERBOSE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -s|--simple)
            OUTPUT_MODE="simple"
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -p|--path)
            OUTPUT_MODE="path"
            shift
            ;;
        -n|--name)
            OUTPUT_MODE="name"
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "エラー: 不明なオプション: $1"
            show_help
            exit 1
            ;;
    esac
done

# 現在のディレクトリ
CURRENT_DIR=$(pwd)

# git状態を取得する関数
get_git_status() {
    local path="$1"
    local original_dir=$(pwd)
    cd "$path"

    # 変更ファイル数
    local changed_files=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')

    # ahead/behind 情報
    local ahead_behind=""
    local tracking=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
    if [ -n "$tracking" ]; then
        local ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo "0")
        local behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo "0")
        if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
            ahead_behind="ahead $ahead, behind $behind"
        elif [ "$ahead" -gt 0 ]; then
            ahead_behind="ahead $ahead"
        elif [ "$behind" -gt 0 ]; then
            ahead_behind="behind $behind"
        fi
    fi

    # 状態文字列の構築
    local status
    if [ "$changed_files" -eq 0 ]; then
        status="${GREEN}clean${NC}"
    else
        status="${YELLOW}dirty${NC} ($changed_files files)"
    fi

    if [ -n "$ahead_behind" ]; then
        status="$status, ${BLUE}$ahead_behind${NC}"
    fi

    cd "$original_dir"
    echo "$status"
}

# 変更ファイルを表示する関数
show_changed_files() {
    local path="$1"
    local original_dir=$(pwd)
    cd "$path"

    local changed_files=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    if [ "$changed_files" -gt 0 ]; then
        git status --porcelain 2>/dev/null | head -10 | while read -r line; do
            echo "    $line"
        done
        if [ "$changed_files" -gt 10 ]; then
            echo "    ... and $((changed_files - 10)) more"
        fi
    fi

    cd "$original_dir"
}

# worktreeを表示する関数
display_worktree() {
    local name="$1"
    local path="$2"
    local branch="$3"

    case "$OUTPUT_MODE" in
        path)
            echo "$path"
            ;;
        name)
            echo "$name"
            ;;
        simple)
            # 現在のディレクトリかどうか
            if [[ "$CURRENT_DIR" == "$path"* ]]; then
                echo -e "${GREEN}* $name${NC}\t$path"
            else
                echo -e "  $name\t$path"
            fi
            ;;
        default)
            # 現在のディレクトリマーカー
            local marker=" "
            local name_color="$NC"
            if [[ "$CURRENT_DIR" == "$path"* ]]; then
                marker="*"
                name_color="$GREEN"
            fi

            # git状態を取得
            local status=$(get_git_status "$path")

            # 出力
            printf "%s ${name_color}%-20s${NC} %b\n" "$marker" "$name" "$status"

            # verbose モードの場合は変更ファイルを表示
            if [ "$VERBOSE" = true ]; then
                show_changed_files "$path"
            fi
            ;;
    esac
}

# Bare構成かどうかをチェック
if is_bare_structure; then
    # Bare構成: git worktree list を使用
    PROJECT_ROOT=$(find_project_root)
    GIT_DIR=$(find_bare_dir)

    found=false

    while IFS=$'\t' read -r path branch; do
        [ -z "$path" ] && continue
        name=$(basename "$path")
        display_worktree "$name" "$path" "$branch"
        found=true
    done < <(list_worktrees)

    if [ "$found" = false ]; then
        if [ "$OUTPUT_MODE" = "default" ] || [ "$OUTPUT_MODE" = "simple" ]; then
            echo "worktreeが見つかりません"
        fi
    fi
else
    # 従来の構成: 親ディレクトリのサブディレクトリを探す
    PARENT_DIR="$(cd .. 2>/dev/null && pwd)"

    if [ -z "$PARENT_DIR" ]; then
        echo "エラー: 親ディレクトリが見つかりません" >&2
        exit 1
    fi

    # worktree一覧を取得して表示
    found=false

    for dir in "$PARENT_DIR"/*/; do
        if [ -d "$dir" ]; then
            # .gitファイルまたは.gitディレクトリがあればworktree
            if [ -f "$dir/.git" ] || [ -d "$dir/.git" ]; then
                name=$(basename "$dir")
                path="${dir%/}"
                display_worktree "$name" "$path" ""
                found=true
            fi
        fi
    done

    if [ "$found" = false ]; then
        if [ "$OUTPUT_MODE" = "default" ] || [ "$OUTPUT_MODE" = "simple" ]; then
            echo "worktreeが見つかりません"
        fi
        exit 0
    fi
fi
