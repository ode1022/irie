#!/bin/bash

# irie info - worktree情報表示
# Usage: irie info [directory]

set -e

# irieディレクトリ（このスクリプトの場所）
IRIE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# ヘルパー関数を読み込み
source "${IRIE_DIR}/lib/helpers.sh"

# カラー出力用
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

show_help() {
    cat << 'EOF'
irie info - worktree情報表示

使い方:
  irie info [directory]

オプション:
  -h, --help    このヘルプを表示

説明:
  カレントディレクトリまたは指定ディレクトリのworktree情報を表示します。
  プロジェクトのpost-setup.shにirie_info関数が定義されていれば、
  プロジェクト固有の情報も表示します。

例:
  irie info              # カレントディレクトリの情報
  irie info ../app1      # 指定ディレクトリの情報

post-setup.shでの定義例:
  irie_info() {
      echo "ADMIN_URL=https://admin.${WORKTREE_FQDN}/"
      echo "API_URL=https://api.${WORKTREE_FQDN}/"
  }
EOF
}

# 引数解析
TARGET_DIR=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            if [ -z "$TARGET_DIR" ]; then
                TARGET_DIR="$1"
            fi
            shift
            ;;
    esac
done

# ターゲットディレクトリの決定
if [ -n "$TARGET_DIR" ]; then
    if [ ! -d "$TARGET_DIR" ]; then
        echo -e "${RED}エラー: ディレクトリが存在しません: $TARGET_DIR${NC}"
        exit 1
    fi
    cd "$TARGET_DIR"
fi

WORKTREE_PATH="$(pwd)"

# Gitリポジトリかチェック
if ! git rev-parse --git-dir &>/dev/null; then
    echo -e "${RED}エラー: Gitリポジトリではありません${NC}"
    exit 1
fi

# プロジェクト名を取得（gitリポジトリ名優先、なければカレントディレクトリ名）
if git config --get remote.origin.url &>/dev/null; then
    PROJECT_NAME=$(basename -s .git "$(git config --get remote.origin.url)")
else
    PROJECT_NAME=$(basename "$(git rev-parse --show-toplevel)")
fi

# ブランチ名を取得
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)

# ディレクトリ名を取得
DIR_NAME=$(basename "$WORKTREE_PATH")

# ブランチ名からディレクトリ名を生成（比較用）
if [[ "$BRANCH_NAME" == *"/"* ]]; then
    TEMP_NAME=${BRANCH_NAME#feat/}
    EXPECTED_DIR_NAME=${TEMP_NAME//\//-}
else
    EXPECTED_DIR_NAME=$BRANCH_NAME
fi

# チケットシステムのプロジェクトキーを削除
STRIPPED_DIR=$(strip_ticket_project_key "$DIR_NAME")

# FQDNを計算（Traefik方式: *.localhost）
BASE_DOMAIN="${PROJECT_NAME}.localhost"
SUBDOMAIN=$(echo "$STRIPPED_DIR" | tr '[:upper:]' '[:lower:]' | tr '_' '-')

# ルートドメインかサブドメインかを判定
# WORKTREE_PREFIXはサブドメイン接頭辞（rootモードは空、通常はドット付き）
if [ "$DIR_NAME" = "main" ] || [ "$DIR_NAME" = "master" ]; then
    FQDN="${BASE_DOMAIN}"
    WORKTREE_PREFIX=""
    TRAEFIK_ID="${PROJECT_NAME}"
else
    FQDN="${SUBDOMAIN}.${BASE_DOMAIN}"
    WORKTREE_PREFIX="${SUBDOMAIN}."
    TRAEFIK_ID="${PROJECT_NAME}-${SUBDOMAIN}"
fi

# DB名を生成
DB_NAME=$(generate_safe_db_name "$PROJECT_NAME" "$DIR_NAME")

# docker-compose-worktreeディレクトリを探す（post-setup.sh用）
find_source_dir() {
    local current="$WORKTREE_PATH"
    local parent="$(dirname "$current")"

    # 親ディレクトリ内でdocker-compose-worktreeを探す
    for dir in "$parent"/*; do
        if [ -d "$dir" ] && [ -f "$dir/post-setup.sh" ]; then
            echo "$dir"
            return 0
        fi
    done

    # 見つからない場合は空
    echo ""
}

SOURCE_DIR=$(find_source_dir)

# 情報表示
echo ""
echo -e "${BLUE}=== Worktree情報 ===${NC}"
echo -e "${YELLOW}ディレクトリ:${NC} $DIR_NAME"
echo -e "${YELLOW}ブランチ:${NC} $BRANCH_NAME"
echo -e "${YELLOW}パス:${NC} $WORKTREE_PATH"
echo ""
echo -e "${YELLOW}URL:${NC} https://${FQDN}/"
echo -e "${YELLOW}TRAEFIK_ID:${NC} $TRAEFIK_ID"

# .varsファイルからDBモード情報を読み込み
IRIE_WORKTREES_DIR="$HOME/.irie/worktrees/${PROJECT_NAME}"
VARS_FILE="${IRIE_WORKTREES_DIR}/${DIR_NAME}.vars"
if [ -f "$VARS_FILE" ]; then
    source "$VARS_FILE"
    echo -e "${YELLOW}DB名:${NC} $WORKTREE_DB_NAME"
    if [ "$WORKTREE_USE_SEPARATE_DB" = "true" ]; then
        echo -e "${YELLOW}DBモード:${NC} separate-db（専用）"
    else
        echo -e "${YELLOW}DBモード:${NC} mainと共有"
    fi
else
    echo -e "${YELLOW}DB名:${NC} $DB_NAME"
    echo -e "${YELLOW}DBモード:${NC} (不明)"
fi

# Traefikダッシュボード
echo ""
echo -e "${BLUE}Traefikダッシュボード:${NC}"
echo "  http://traefik.localhost/"

# プロジェクト固有情報を取得（irie_info関数があれば）
if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/post-setup.sh" ]; then
    # 環境変数をエクスポート
    export WORKTREE_DIR="$DIR_NAME"
    export WORKTREE_BRANCH="$BRANCH_NAME"
    export WORKTREE_FQDN="$FQDN"
    export WORKTREE_PREFIX="$WORKTREE_PREFIX"
    export BASE_DOMAIN="$BASE_DOMAIN"
    export WORKTREE_DB_NAME="$DB_NAME"
    export WORKTREE_SOURCE_DIR="$SOURCE_DIR"
    export WORKTREE_TRAEFIK_ID="$TRAEFIK_ID"
    export IRIE_LIB_DIR="${IRIE_DIR}/lib"

    # post-setup.shをsourceしてirie_info関数があれば実行
    # IRIE_INFO_ONLY=trueで関数定義のみ取得（セットアップ処理は実行しない）
    PROJECT_INFO=$(
        export IRIE_INFO_ONLY=true
        source "$SOURCE_DIR/post-setup.sh" 2>/dev/null || true
        if declare -f irie_info &>/dev/null; then
            irie_info
        fi
    )

    if [ -n "$PROJECT_INFO" ]; then
        echo ""
        echo -e "${BLUE}=== プロジェクト固有情報 ===${NC}"
        while IFS='=' read -r key value; do
            if [ -n "$key" ] && [ -n "$value" ]; then
                echo -e "${YELLOW}${key}:${NC} $value"
            fi
        done <<< "$PROJECT_INFO"
    fi
fi

echo ""
