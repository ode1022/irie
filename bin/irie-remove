#!/bin/bash

# Git worktree削除スクリプト
# Usage: ./cleanup_worktree.sh <dir-name> [--force]
# Example:
#   ./cleanup_worktree.sh codex
#   ./cleanup_worktree.sh new-feature --force

set -e

# ステータスメッセージはstderrに出力（docker等と同じストリームにして順序を保証）
# exec 3>&1: fd3に元のstdoutを保存（シェル関数がcdパスをキャプチャするため）
# exec 1>&2: fd1をstderrに上書き（以降のechoはすべてstderrに出力される）
exec 3>&1 1>&2

# カラー出力用
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# irieディレクトリ（このスクリプトの場所）
IRIE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# ヘルパー関数を読み込み
source "${IRIE_DIR}/lib/helpers.sh"
source "${IRIE_DIR}/lib/git-helpers.sh"

# カレントディレクトリを基準とする
CURRENT_DIR="$(pwd)"

# Bare構成のプロジェクトルートかどうかを判定
if [ -d "$CURRENT_DIR/.bare" ]; then
    # プロジェクトルートから実行 → mainフォルダを使用
    if [ -d "$CURRENT_DIR/main" ]; then
        WORK_DIR="$CURRENT_DIR/main"
        PROJECT_ROOT="$CURRENT_DIR"
    else
        echo -e "${RED}エラー: mainフォルダが見つかりません${NC}"
        exit 1
    fi
elif is_bare_structure "$CURRENT_DIR" 2>/dev/null; then
    # worktree内から実行 → そのフォルダを使用
    WORK_DIR="$CURRENT_DIR"
    PROJECT_ROOT=$(find_project_root "$CURRENT_DIR")
else
    # 通常のgit構成
    WORK_DIR="$CURRENT_DIR"
    PROJECT_ROOT="$(cd .. 2>/dev/null && pwd)"
fi

# プロジェクト名を取得（gitリポジトリ名優先、なければカレントディレクトリ名）
if git_cmd config --get remote.origin.url &>/dev/null; then
    PROJECT_NAME=$(basename -s .git "$(git_cmd config --get remote.origin.url)")
elif [ -n "$PROJECT_ROOT" ]; then
    PROJECT_NAME=$(basename "$PROJECT_ROOT")
else
    PROJECT_NAME=$(basename "$(pwd)")
fi

show_help() {
    cat << EOF
irie remove - worktreeを削除

使い方:
  irie remove [dir-name] [options]

引数:
  dir-name          削除するworktree名（省略時はfzfで選択）
  .                 現在のworktreeを削除

オプション:
  -f, --force       確認なしで削除（未マージブランチも強制削除）
  -h, --help        このヘルプを表示

ブランチ削除:
  - 通常: マージ済みブランチのみ自動削除（git branch -d）
  - --force: 未マージでも強制削除（git branch -D）

例:
  irie remove                         # fzfで対話的に選択
  irie remove .                       # 現在のworktreeを削除
  irie remove new-feature             # 確認あり、マージ済みブランチは削除
  irie remove new-feature --force     # 確認なし、ブランチ強制削除
EOF
}

# 引数解析
FORCE=false
DIR_NAME=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --force|-f)
            FORCE=true
            shift
            ;;
        *)
            if [ -z "$DIR_NAME" ]; then
                DIR_NAME=$1
            fi
            shift
            ;;
    esac
done

# "." が指定された場合は現在のworktree名を使用
if [ "$DIR_NAME" = "." ]; then
    # 現在のディレクトリ名を取得
    CURRENT_WORKTREE_NAME=$(basename "$CURRENT_DIR")

    # 現在のディレクトリがworktreeかチェック
    if [ ! -f "$CURRENT_DIR/.git" ] && [ ! -d "$CURRENT_DIR/.git" ]; then
        echo -e "${RED}エラー: 現在のディレクトリはworktreeではありません${NC}"
        exit 1
    fi

    # mainは削除不可
    if [ "$CURRENT_WORKTREE_NAME" = "main" ]; then
        echo -e "${RED}エラー: mainワークツリーは削除できません${NC}"
        exit 1
    fi

    DIR_NAME="$CURRENT_WORKTREE_NAME"
fi

# 引数がない場合はfzfで選択
if [ -z "$DIR_NAME" ]; then
    # fzfがインストールされているか確認
    if ! command -v fzf &> /dev/null; then
        echo -e "${RED}エラー: ディレクトリ名を指定してください${NC}"
        echo -e "${YELLOW}ヒント: fzfをインストールすると対話的に選択できます${NC}"
        echo ""
        echo "Usage: irie remove <dir-name> [--force]"
        exit 1
    fi

    # worktree一覧を取得
    WORKTREES=()
    for dir in "$PROJECT_ROOT"/*/; do
        if [ -d "$dir" ]; then
            name=$(basename "$dir")
            # main以外の.gitファイルまたは.gitディレクトリがあるディレクトリ
            if [ "$name" != "main" ] && { [ -f "$dir/.git" ] || [ -d "$dir/.git" ]; }; then
                WORKTREES+=("$name")
            fi
        fi
    done

    if [ ${#WORKTREES[@]} -eq 0 ]; then
        echo -e "${YELLOW}削除可能なworktreeがありません${NC}"
        exit 0
    fi

    # fzfで選択
    DIR_NAME=$(printf '%s\n' "${WORKTREES[@]}" | fzf --prompt="削除するworktreeを選択: " --height=40% --reverse)

    if [ -z "$DIR_NAME" ]; then
        echo -e "${YELLOW}キャンセルしました${NC}"
        exit 0
    fi
fi

WORKTREE_PATH="${PROJECT_ROOT}/${DIR_NAME}"

# 存在確認
if [ ! -d "$WORKTREE_PATH" ]; then
    echo -e "${RED}エラー: ディレクトリが存在しません: ${WORKTREE_PATH}${NC}"
    exit 1
fi

echo ""
echo -e "${BLUE}=== Worktree削除開始 ===${NC}"
echo -e "${YELLOW}ディレクトリ: ${DIR_NAME}${NC}"
echo ""

# 確認（--forceでスキップ）
if [ "$FORCE" = false ]; then
    read -p "削除してよろしいですか？ (y/N): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}キャンセルしました${NC}"
        exit 0
    fi
fi

# 1. Dockerコンテナ停止・削除
echo -e "${GREEN}[1/4] Dockerコンテナを停止・削除中...${NC}"
cd "$WORKTREE_PATH"
if [ -f "docker-compose.yaml" ] || [ -f "docker-compose.yml" ]; then
    docker compose down -v 2>/dev/null || true
    echo -e "${GREEN}✓ コンテナ停止完了${NC}"
else
    echo -e "${YELLOW}  → docker-compose.yamlが見つかりません（スキップ）${NC}"
fi

# 2. クリーンアップフック実行（post-cleanup.sh）
echo -e "${GREEN}[2/4] クリーンアップフックを実行中...${NC}"
POST_CLEANUP_SCRIPT="${WORK_DIR}/post-cleanup.sh"

# .varsファイルからDBモード情報を読み込み
IRIE_WORKTREES_DIR="$HOME/.irie/worktrees/${PROJECT_NAME}"
VARS_FILE="${IRIE_WORKTREES_DIR}/${DIR_NAME}.vars"
WORKTREE_USE_SEPARATE_DB="true"  # デフォルト: 専用DB（レガシーworktree用の安全なデフォルト）
WORKTREE_SEPARATE_DB_NAME=""
if [ -f "$VARS_FILE" ]; then
    source "$VARS_FILE"
fi

if [ -f "$POST_CLEANUP_SCRIPT" ]; then
    echo -e "${BLUE}  → post-cleanup.sh を実行中...${NC}"
    # DB名を生成（.varsがない場合のフォールバック）
    if [ -z "$WORKTREE_DB_NAME" ]; then
        WORKTREE_DB_NAME=$(generate_safe_db_name "$PROJECT_NAME" "$DIR_NAME")
    fi
    if [ -z "$WORKTREE_SEPARATE_DB_NAME" ]; then
        WORKTREE_SEPARATE_DB_NAME=$(generate_safe_db_name "$PROJECT_NAME" "$DIR_NAME")
    fi
    # 環境変数をエクスポートしてフックスクリプトに渡す
    export WORKTREE_DIR="$DIR_NAME"
    export WORKTREE_PATH="$WORKTREE_PATH"
    export WORKTREE_SOURCE_DIR="$WORK_DIR"
    export WORKTREE_FORCE="$FORCE"
    export WORKTREE_USE_SEPARATE_DB="${WORKTREE_USE_SEPARATE_DB}"
    export WORKTREE_SEPARATE_DB_NAME="${WORKTREE_SEPARATE_DB_NAME}"
    export WORKTREE_DB_NAME="${WORKTREE_DB_NAME}"
    export IRIE_LIB_DIR="${IRIE_DIR}/lib"
    bash "$POST_CLEANUP_SCRIPT"
    echo -e "${GREEN}  ✓ post-cleanup.sh 完了${NC}"
else
    echo -e "${YELLOW}  → post-cleanup.sh が見つかりません（スキップ）${NC}"
fi

# .varsファイルを削除
if [ -f "$VARS_FILE" ]; then
    rm -f "$VARS_FILE"
fi

# 3. Git worktree削除
echo -e "${GREEN}[3/4] Git worktreeを削除中...${NC}"
# 削除対象のworktree内にいる場合は別のworktreeに移動
WORKTREE_REALPATH=$(realpath "$WORKTREE_PATH")
WORK_DIR_REALPATH=$(realpath "$WORK_DIR")
if [ "$WORKTREE_REALPATH" = "$WORK_DIR_REALPATH" ]; then
    # 親ディレクトリの別worktreeを探す
    PARENT_DIR="$(dirname "$WORKTREE_PATH")"
    ALTERNATIVE_DIR=""
    for dir in "$PARENT_DIR"/*/; do
        dir_name=$(basename "$dir")
        if [ "$dir_name" != "$DIR_NAME" ] && { [ -d "$dir/.git" ] || [ -f "$dir/.git" ]; }; then
            ALTERNATIVE_DIR="$dir"
            break
        fi
    done
    if [ -n "$ALTERNATIVE_DIR" ]; then
        cd "$ALTERNATIVE_DIR"
    else
        echo -e "${YELLOW}  → 別のworktreeが見つかりません${NC}"
    fi
else
    cd "$WORK_DIR"
fi
# 絶対パスでworktreeを削除（相対パスだとカレントディレクトリ依存で失敗する可能性）
if ! git worktree remove "$WORKTREE_PATH" --force 2>&1; then
    echo -e "${RED}エラー: git worktree removeに失敗しました${NC}"
    echo -e "${YELLOW}対象パス: $WORKTREE_PATH${NC}"
    echo ""
    echo -e "${YELLOW}手動で確認してください:${NC}"
    echo "  git worktree list"
    echo "  git worktree prune  # 孤立したworktree情報を削除"
    echo "  rm -rf $WORKTREE_PATH  # ディレクトリを手動削除"
    exit 1
fi
echo -e "${GREEN}✓ Worktree削除完了${NC}"

# 4. ブランチ削除
echo -e "${GREEN}[4/4] ブランチ削除中...${NC}"
# worktreeに紐づいていたブランチを探す
# +はworktree紐づき、*はカレントブランチを示す記号なので除去
BRANCH_NAME=$(git branch --list | grep -E "feat/${DIR_NAME}|${DIR_NAME}" | head -1 | tr -d ' *+')
if [ -n "$BRANCH_NAME" ]; then
    if [ "$FORCE" = true ]; then
        # --force時は強制削除
        git branch -D "$BRANCH_NAME" 2>/dev/null && \
            echo -e "${GREEN}  ✓ ブランチ ${BRANCH_NAME} を強制削除${NC}" || \
            echo -e "${YELLOW}  → ブランチ削除をスキップ${NC}"
    else
        # 通常時はマージ済みのみ削除（-d）
        if git branch -d "$BRANCH_NAME" 2>/dev/null; then
            echo -e "${GREEN}  ✓ ブランチ ${BRANCH_NAME} を削除${NC}"
        else
            echo -e "${YELLOW}  → ブランチ ${BRANCH_NAME} は未マージのため削除をスキップ${NC}"
            echo -e "${YELLOW}    強制削除: git branch -D ${BRANCH_NAME}${NC}"
        fi
    fi
else
    echo -e "${BLUE}  → 関連ブランチなし${NC}"
fi

# 削除したworktree内にいた場合
WAS_IN_DELETED_WORKTREE=false
if [ "$WORK_DIR_REALPATH" = "$WORKTREE_REALPATH" ]; then
    WAS_IN_DELETED_WORKTREE=true
fi

echo ""
echo -e "${GREEN}=== 削除完了 ===${NC}"
echo ""

# シェル統合用（削除したworktree内にいた場合、プロジェクトルートへ自動cd）
if [ "$WAS_IN_DELETED_WORKTREE" = true ]; then
    echo "${PROJECT_ROOT}" >&3
fi
