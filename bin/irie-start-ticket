#!/bin/bash

# irie start-ticket - チケットURLからブランチを作成しClaude Codeを起動
# Claude Codeがチケットシステムを自動判別して情報を取得

set -e

# カラー出力用
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

show_help() {
    cat << 'EOF'
irie start-ticket - チケットURLからブランチを作成しClaude Codeを起動

使い方:
  irie start-ticket <ticket-url>

引数:
  ticket-url      チケットのURL
                  Backlog, GitHub Issues, GitLab, Jira, Linear など
                  Claude Codeが自動でチケットシステムを判別します

オプション:
  --dry-run       ブランチ名の決定のみ行い、実際の作成は行わない
  --no-claude     worktree作成後にClaude Codeを起動しない
  -h, --help      このヘルプを表示

処理の流れ:
  1. Claude CodeがURLからチケットシステムを自動判別
  2. 適切なツール（MCP, CLI, WebFetch等）でチケット詳細を取得
  3. チケット内容を解析してブランチ名を決定
  4. irie add でworktreeを作成
  5. 作成したworktreeでClaude Codeを起動（チケット情報付き）

例:
  irie start-ticket https://activert.backlog.com/view/SW_CHIYODA-1048
  irie start-ticket https://github.com/owner/repo/issues/123
  irie start-ticket https://company.atlassian.net/browse/PROJ-456 --dry-run
EOF
}

# 引数パース
TICKET_URL=""
DRY_RUN=false
NO_CLAUDE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --no-claude)
            NO_CLAUDE=true
            shift
            ;;
        *)
            if [ -z "$TICKET_URL" ]; then
                TICKET_URL="$1"
            fi
            shift
            ;;
    esac
done

if [ -z "$TICKET_URL" ]; then
    echo -e "${RED}エラー: チケットURLを指定してください${NC}"
    echo ""
    show_help
    exit 1
fi

# claudeコマンドの存在確認
if ! command -v claude &> /dev/null; then
    echo -e "${RED}エラー: claudeコマンドが見つかりません${NC}"
    echo "Claude Codeをインストールしてください"
    exit 1
fi

echo -e "${BLUE}チケットURL:${NC} $TICKET_URL"
echo ""

# Claude Codeでブランチ名を決定
echo -e "${CYAN}チケット情報を取得してブランチ名を決定中...${NC}"

BRANCH_NAME_PROMPT="以下のURLからチケット情報を取得し、Gitブランチ名を決定してください。

URL: $TICKET_URL

手順:
1. URLからチケットシステムを判別
2. 適切な方法でチケット情報を取得（MCPやCLIを優先、認証が必要なのでWebFetchは基本使えない）:
   - Backlog: mcp__backlog__get_issue を使用
   - GitHub: gh issue view コマンドを使用
   - GitLab: glab issue view コマンドを使用
   - Jira: Jira MCPを使用
   - Linear: Linear MCPを使用
   - その他: 対応するMCPまたはCLIを探して使用
3. チケットのタイトルと内容を確認
4. 以下のルールに従ってブランチ名を決定

ブランチ名のルール:
- 形式: feat/<チケットキー>-<簡潔な説明>
- チケットキーはURLから抽出したものをそのまま使用
- 説明部分は英語でケバブケース（kebab-case）
- 説明は15文字以内に収める
- 例: feat/SW_CHIYODA-1048-coupon-rank, feat/repo#123-fix-bug

最終的にブランチ名のみを出力してください（説明や前置き不要）。"

BRANCH_NAME=$(claude -p "$BRANCH_NAME_PROMPT" 2>/dev/null | tail -1 | tr -d '[:space:]' | tr -d '`')

if [ -z "$BRANCH_NAME" ]; then
    echo -e "${RED}エラー: ブランチ名の決定に失敗しました${NC}"
    exit 1
fi

# ブランチ名の検証（feat/で始まるか）
if [[ ! "$BRANCH_NAME" =~ ^feat/ ]]; then
    echo -e "${YELLOW}警告: ブランチ名がfeat/で始まっていません: $BRANCH_NAME${NC}"
    echo -e "${YELLOW}feat/を付加します${NC}"
    BRANCH_NAME="feat/$BRANCH_NAME"
fi

echo -e "${GREEN}決定したブランチ名:${NC} $BRANCH_NAME"
echo ""

if [ "$DRY_RUN" = true ]; then
    echo -e "${YELLOW}--dry-run: 実際の作成は行いません${NC}"
    exit 0
fi

# irie addでworktreeを作成
echo -e "${CYAN}worktreeを作成中...${NC}"
WORKTREE_OUTPUT=$(irie add "$BRANCH_NAME" 2>&1) || {
    echo -e "${RED}エラー: worktreeの作成に失敗しました${NC}"
    echo "$WORKTREE_OUTPUT"
    exit 1
}

echo "$WORKTREE_OUTPUT"

# worktreeのパスを取得
DIR_NAME="${BRANCH_NAME#feat/}"

# カレントディレクトリがbare構成のルートかworktree内かを判定
if [ -d ".bare" ]; then
    WORKTREE_PATH="$(pwd)/$DIR_NAME"
elif [ -d "../.bare" ]; then
    WORKTREE_PATH="$(dirname "$(pwd)")/$DIR_NAME"
else
    # 通常のgitリポジトリの場合
    WORKTREE_PATH=$(git worktree list --porcelain | grep -A2 "worktree.*$DIR_NAME" | head -1 | sed 's/worktree //')
fi

if [ ! -d "$WORKTREE_PATH" ]; then
    echo -e "${YELLOW}警告: worktreeパスの自動検出に失敗しました${NC}"
    echo -e "${YELLOW}手動でディレクトリに移動してclaudeを起動してください${NC}"
    exit 0
fi

echo ""
echo -e "${GREEN}worktree作成完了:${NC} $WORKTREE_PATH"

if [ "$NO_CLAUDE" = true ]; then
    echo ""
    echo -e "${YELLOW}--no-claude: Claude Codeは起動しません${NC}"
    echo -e "手動で起動する場合: cd $WORKTREE_PATH && claude"
    exit 0
fi

# 新しいworktreeでClaude Codeを起動
echo ""
echo -e "${CYAN}Claude Codeを起動中...${NC}"

cd "$WORKTREE_PATH"

CLAUDE_PROMPT="チケット対応を開始します。

チケットURL: $TICKET_URL

まずチケット詳細を取得し（URLからチケットシステムを判別して適切なツールを使用）、
作業内容を確認してから作業計画を立ててください。"

exec claude "$CLAUDE_PROMPT"
