#!/bin/bash

# irie override - テンプレートからdocker-compose.override.ymlを生成
# Usage: irie override <traefik|loopback|loopback-shared-db> [--setup]

set -e

# カラー出力用
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

IRIE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# ヘルパー関数を読み込み
source "${IRIE_DIR}/lib/helpers.sh"
source "${IRIE_DIR}/lib/git-helpers.sh"

show_help() {
    cat << 'EOF'
irie override - テンプレートからdocker-compose.override.ymlを生成

使い方:
  irie override [options]

オプション:
  --setup              コンテナ起動とpost-setup.shも実行

説明:
  docker-compose.override.traefik-example.ymlを読み込み、
  プレースホルダーを置換してdocker-compose.override.ymlを生成します。

  mainやworktreeで実行可能。irie init後にmainで使用する場合に便利。

例:
  cd my-project/main
  irie override             # override.ymlのみ生成
  irie override --setup     # 生成 + コンテナ起動 + 初期セットアップ
EOF
}

# 引数チェック
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
    exit 0
fi

# 引数解析
RUN_SETUP=false

for arg in "$@"; do
    case "$arg" in
        --setup)
            RUN_SETUP=true
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            echo -e "${RED}エラー: 不明なオプション: $arg${NC}"
            exit 1
            ;;
    esac
done

# テンプレートファイル名（Traefikのみ）
TEMPLATE_FILE="docker-compose.override.traefik-example.yml"

# カレントディレクトリを基準とする
CURRENT_DIR="$(pwd)"

# テンプレートファイルの存在確認
if [ ! -f "$TEMPLATE_FILE" ]; then
    echo -e "${RED}エラー: テンプレートが見つかりません: $TEMPLATE_FILE${NC}"
    echo "irie init でテンプレートを生成してください"
    exit 1
fi

# override.ymlが既に存在する場合は確認
OVERRIDE_FILE="docker-compose.override.yml"
if [ -f "$OVERRIDE_FILE" ]; then
    echo -e "${YELLOW}警告: $OVERRIDE_FILE が既に存在します${NC}"
    read -p "上書きしますか？ [y/N]: " confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
        echo "キャンセルしました"
        exit 0
    fi
fi

# プロジェクト名を取得
if git rev-parse --git-dir &>/dev/null; then
    if git config --get remote.origin.url &>/dev/null; then
        PROJECT_NAME=$(basename -s .git "$(git config --get remote.origin.url)")
    else
        # リモートがない場合はディレクトリ名から
        PROJECT_NAME=$(basename "$(git rev-parse --show-toplevel)")
    fi
else
    PROJECT_NAME=$(basename "$(pwd)")
fi

# ディレクトリ名を取得（worktree名）
DIR_NAME=$(basename "$CURRENT_DIR")

# プレースホルダーの値を生成
DB_PREFIX=$(echo "$PROJECT_NAME" | tr '-' '_')
DB_NAME="${DB_PREFIX}_$(echo "$DIR_NAME" | tr '-' '_')"
BASE_DOMAIN="${PROJECT_NAME}.localhost"

# モードに応じてFQDNとWORKTREE_PREFIXを生成
if [ "$DIR_NAME" = "main" ]; then
    # mainの場合はルートドメイン
    FQDN="${BASE_DOMAIN}"
    WORKTREE_PREFIX=""
    TRAEFIK_ID="${PROJECT_NAME}"
else
    FQDN="${DIR_NAME}.${BASE_DOMAIN}"
    WORKTREE_PREFIX="${DIR_NAME}."
    TRAEFIK_ID="${PROJECT_NAME}-${DIR_NAME}"
fi

echo -e "${BLUE}=== irie override ===${NC}"
echo "ディレクトリ: $DIR_NAME"
echo "プロジェクト: $PROJECT_NAME"
echo "FQDN: $FQDN"
echo "DB名: $DB_NAME"
echo ""

# テンプレートをコピー
cp "$TEMPLATE_FILE" "$OVERRIDE_FILE"

# プレースホルダーを置換
sed_inplace "s/{{DIR_NAME}}/${DIR_NAME}/g" "$OVERRIDE_FILE"
sed_inplace "s/{{FQDN}}/${FQDN}/g" "$OVERRIDE_FILE"
sed_inplace "s/{{WORKTREE_PREFIX}}/${WORKTREE_PREFIX}/g" "$OVERRIDE_FILE"
sed_inplace "s/{{BASE_DOMAIN}}/${BASE_DOMAIN}/g" "$OVERRIDE_FILE"
sed_inplace "s/{{DB_NAME}}/${DB_NAME}/g" "$OVERRIDE_FILE"
sed_inplace "s/{{TRAEFIK_ID}}/${TRAEFIK_ID}/g" "$OVERRIDE_FILE"

echo -e "${GREEN}✓ $OVERRIDE_FILE を生成しました${NC}"

# --setup オプション: コンテナ起動 + post-setup.sh実行
if [ "$RUN_SETUP" = true ]; then
    echo ""
    echo -e "${BLUE}=== セットアップ実行 ===${NC}"

    # コンテナ起動
    echo -e "${GREEN}  → docker compose up -d${NC}"
    docker compose up -d

    # post-setup.shが存在すれば実行
    if [ -f "post-setup.sh" ]; then
        echo -e "${GREEN}  → post-setup.sh を実行中...${NC}"

        # 現在のブランチ名を取得
        BRANCH_NAME=$(git branch --show-current 2>/dev/null || echo "main")

        # 環境変数をエクスポートしてpost-setup.shを実行
        export WORKTREE_DIR="$DIR_NAME"
        export WORKTREE_BRANCH="$BRANCH_NAME"
        export WORKTREE_FQDN="$FQDN"
        export WORKTREE_PREFIX="$WORKTREE_PREFIX"
        export BASE_DOMAIN="$BASE_DOMAIN"
        export WORKTREE_DB_NAME="$DB_NAME"
        export WORKTREE_SOURCE_DIR="$CURRENT_DIR"
        export WORKTREE_TRAEFIK_ID="$TRAEFIK_ID"
        export IRIE_LIB_DIR="${IRIE_DIR}/lib"

        bash "./post-setup.sh"

        echo ""
        echo -e "${GREEN}=== セットアップ完了 ===${NC}"
    else
        echo -e "${YELLOW}  → post-setup.sh が見つかりません（スキップ）${NC}"
    fi

    echo ""
    echo -e "${YELLOW}アクセスURL:${NC}"
    echo "  http://${FQDN}/"

    # post-setup.shのirie_info関数があれば呼び出してプロジェクト固有URLを表示
    if [ -f "post-setup.sh" ]; then
        PROJECT_INFO=$(
            export IRIE_INFO_ONLY=true
            export WORKTREE_DIR="$DIR_NAME"
            export WORKTREE_FQDN="$FQDN"
            export WORKTREE_PREFIX="$WORKTREE_PREFIX"
            export BASE_DOMAIN="$BASE_DOMAIN"
            export WORKTREE_TRAEFIK_ID="$TRAEFIK_ID"
            source "./post-setup.sh" 2>/dev/null || true
            if declare -f irie_info &>/dev/null; then
                irie_info
            fi
        )
        if [ -n "$PROJECT_INFO" ]; then
            echo ""
            echo -e "${YELLOW}プロジェクト固有URL:${NC}"
            echo "$PROJECT_INFO" | while IFS='=' read -r key value; do
                printf "  %-10s %s\n" "${key}:" "$value"
            done
        fi
    fi
else
    echo ""
    echo "次のステップ:"
    echo "  docker compose up -d"
    if [ -f "post-setup.sh" ]; then
        echo "  # または --setup オプションでセットアップも実行:"
        echo "  irie override --setup"
    fi
fi
